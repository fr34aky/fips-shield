# fips-shield preset: strfry / loose
# Generous limits and slow banning. For a busy public service where a false positive costs more than an abusive peer.
#
# Values here apply only to keys you have NOT set in shield.env.
# Anything you set explicitly always wins. See presets/README.md and
# `shield-config show`.

SHIELD_LISTEN_PORT=80
SHIELD_SERVER_NAME=_
SHIELD_UPSTREAM=127.0.0.1:7777
SHIELD_MAX_CONNS_PER_NODE=16
SHIELD_HANDSHAKE_BURST=20
SHIELD_STRFRY_CONN_RATE=120
SHIELD_WS_IDLE_TIMEOUT=600s
SHIELD_WS_MAX_MSG=131072
SHIELD_WS_MAX_SUBS=40
SHIELD_WS_MAX_FILTERS=20
SHIELD_WS_MAX_FILTER_ITEMS=1000
SHIELD_WS_MAX_HS_READS=64
SHIELD_WS_MAX_MSG_READS=
SHIELD_WS_MAX_LIMIT=10000
SHIELD_WS_MAX_FILTER_VALUE=1024
SHIELD_WS_REQUIRE_NARROWING=false
SHIELD_WS_MSG_RATE=50
SHIELD_WS_MSG_BURST=200
SHIELD_WS_EVENT_RATE=10
SHIELD_WS_EVENT_BURST=100
SHIELD_WS_REQ_RATE=10
SHIELD_WS_REQ_BURST=50
SHIELD_NOSTR_TYPES=EVENT,REQ,CLOSE,COUNT,AUTH,NEG-OPEN,NEG-MSG,NEG-CLOSE
SHIELD_NOSTR_KIND_DENY=
