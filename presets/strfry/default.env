# fips-shield preset: strfry / default
# Balanced. What the project ships and what the smoke tests exercise.
#
# Values here apply only to keys you have NOT set in shield.env.
# Anything you set explicitly always wins. See presets/README.md and
# `shield-config show`.

SHIELD_LISTEN_PORT=80
SHIELD_SERVER_NAME=_
SHIELD_UPSTREAM=127.0.0.1:7777
SHIELD_MAX_CONNS_PER_NODE=12
SHIELD_HANDSHAKE_BURST=10
SHIELD_STRFRY_CONN_RATE=60
SHIELD_WS_IDLE_TIMEOUT=300s
SHIELD_WS_MAX_MSG=131072
SHIELD_WS_MAX_SUBS=50
SHIELD_WS_MAX_FILTERS=20
SHIELD_WS_MAX_FILTER_ITEMS=2000
SHIELD_WS_MAX_HS_READS=32
SHIELD_WS_MAX_MSG_READS=
SHIELD_WS_MAX_LIMIT=5000
SHIELD_WS_MAX_FILTER_VALUE=512
SHIELD_WS_REQUIRE_NARROWING=true
SHIELD_WS_MSG_RATE=30
SHIELD_WS_MSG_BURST=200
SHIELD_WS_EVENT_RATE=5
SHIELD_WS_EVENT_BURST=50
SHIELD_WS_REQ_RATE=10
SHIELD_WS_REQ_BURST=60
SHIELD_NOSTR_TYPES=EVENT,REQ,CLOSE,COUNT,AUTH,NEG-OPEN,NEG-MSG,NEG-CLOSE
SHIELD_NOSTR_KIND_DENY=
