# fips-shield preset: core / loose
# Generous limits and slow banning. For a busy public service where a false positive costs more than an abusive peer.
#
# Values here apply only to keys you have NOT set in shield.env.
# Anything you set explicitly always wins. See presets/README.md and
# `shield-config show`.

SHIELD_HANDSHAKE_RATE=10r/s
SHIELD_HANDSHAKE_ZONE_SIZE=1m
SHIELD_CONN_ZONE_SIZE=1m
SHIELD_CONNRATE_ZONE_SIZE=1m
SHIELD_CONN_WINDOW=60
SHIELD_CONNRATE_TIMEOUT=300s
SHIELD_SOCKET_DIR=/run/fips-shield
SHIELD_BAN_FILE=/var/lib/fips-shield/banlist
SHIELD_BAN_RECHECK=30
SHIELD_BAN_ALSO_FILE=false
SHIELD_F2B_FINDTIME=300
SHIELD_F2B_BANTIME=900
SHIELD_F2B_HANDSHAKE_MAXRETRY=40
SHIELD_F2B_VERDICT_MAXRETRY=50
SHIELD_F2B_ABUSE_MAXRETRY=5
SHIELD_F2B_CONNRATE_MAXRETRY=60
SHIELD_F2B_CONN_MAXRETRY=40
SHIELD_F2B_SCAN_MAXRETRY=15
SHIELD_F2B_IGNOREIP=
SHIELD_F2B_IGNORESELF=true
