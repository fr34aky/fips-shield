# fips-shield preset: http / strict
# Tightest limits and fastest banning. For a node whose clients you know, or one under active abuse.
#
# Values here apply only to keys you have NOT set in shield.env.
# Anything you set explicitly always wins. See presets/README.md and
# `shield-config show`.

SHIELD_HTTP_SERVICE=web
SHIELD_HTTP_LISTEN_PORT=8080
SHIELD_HTTP_UPSTREAM=127.0.0.1:3000
SHIELD_HTTP_SERVER_NAME=_
SHIELD_HTTP_CONN_RATE=60
SHIELD_HTTP_MAX_CONNS_PER_NODE=10
SHIELD_HTTP_IDLE_TIMEOUT=30s
SHIELD_HTTP_REQ_RATE=10r/s
SHIELD_HTTP_REQ_BURST=20
SHIELD_HTTP_METHODS=GET HEAD
SHIELD_HTTP_KEEPALIVE_REQUESTS=50
SHIELD_HTTP_PATH_REGEX=.*
SHIELD_HTTP_MAX_BODY=256k
