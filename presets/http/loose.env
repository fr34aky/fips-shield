# fips-shield preset: http / loose
# Generous limits and slow banning. For a busy public service where a false positive costs more than an abusive peer.
#
# Values here apply only to keys you have NOT set in shield.env.
# Anything you set explicitly always wins. See presets/README.md and
# `shield-config show`.

SHIELD_HTTP_SERVICE=web
SHIELD_HTTP_LISTEN_PORT=8080
SHIELD_HTTP_UPSTREAM=127.0.0.1:3000
SHIELD_HTTP_SERVER_NAME=_
SHIELD_HTTP_CONN_RATE=300
SHIELD_HTTP_MAX_CONNS_PER_NODE=100
SHIELD_HTTP_IDLE_TIMEOUT=300s
SHIELD_HTTP_REQ_RATE=50r/s
SHIELD_HTTP_REQ_BURST=100
SHIELD_HTTP_METHODS=GET HEAD POST PUT DELETE
SHIELD_HTTP_KEEPALIVE_REQUESTS=500
SHIELD_HTTP_PATH_REGEX=.*
SHIELD_HTTP_MAX_BODY=16m
