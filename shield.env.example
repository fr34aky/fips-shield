# fips-shield configuration. Copy to shield.env and edit.
# Consumed by envsubst at render time (host mode: deploy/host/render.sh,
# container mode: the nginx image's template entrypoint) — values land
# verbatim in the nginx config, so quote nothing.

# The fips0 mesh address the shield binds. Find it with:
#   ip -6 addr show fips0        (the fd97:... inet6 address)
# or: sudo fipsctl show status   (the ipv6_addr field)
SHIELD_BIND_ADDR=fd97:dead:beef:dead:beef:dead:beef:dead

# Port the shield listens on. 80 makes the relay reachable as
# ws://<npub>.fips/ with no explicit port.
SHIELD_LISTEN_PORT=80

# server_name for the vhost. "_" accepts any Host header (mesh clients
# connect via <npub>.fips or the raw address interchangeably).
SHIELD_SERVER_NAME=_

# Where the protected strfry listens. Must be loopback — if strfry is
# reachable on fips0 directly, the shield protects nothing.
SHIELD_UPSTREAM=127.0.0.1:7777

# Loopback port of the internal http stage (the stream stage on
# SHIELD_BIND_ADDR proxies to it). Only needs changing on collision.
SHIELD_HTTP_PORT=8080

# --- Limits (all keyed per mesh source address == per node) ---

# WebSocket/NIP-11 handshakes per node. Steady-state clients open one
# connection and keep it; this prices churn and reconnect floods.
SHIELD_HANDSHAKE_RATE=5r/s
SHIELD_HANDSHAKE_BURST=10

# Concurrent connections per node.
SHIELD_MAX_CONNS_PER_NODE=8

# Shared-memory sizes for the limit state. 1m tracks ~16k distinct
# source addresses — plenty for any current mesh.
SHIELD_HANDSHAKE_ZONE_SIZE=1m
SHIELD_CONN_ZONE_SIZE=1m

# Idle timeout for established WebSockets. Nostr clients ping; anything
# silent this long is dead weight.
SHIELD_WS_IDLE_TIMEOUT=300s

# --- WebSocket message policy (Phase 2, enforced inside the WS) ---
# Violating any of these closes the connection (client gets a NOTICE
# and a 1008 Close first) and logs a shield-verdict line.

# Max Nostr message size in bytes (whole message, across fragments).
# Align with strfry's maxWebsocketPayloadSize (default 131072).
SHIELD_WS_MAX_MSG=131072

# Concurrently open subscriptions (REQ) per connection.
SHIELD_WS_MAX_SUBS=20

# Filters per REQ/COUNT, and total complexity items per REQ/COUNT
# (filter keys + entries in ids/authors/kinds/#tag arrays, summed).
SHIELD_WS_MAX_FILTERS=10
SHIELD_WS_MAX_FILTER_ITEMS=500

# Token buckets, per connection: sustained rate (messages/second, may
# be fractional) and burst capacity.
# All message types combined:
SHIELD_WS_MSG_RATE=20
SHIELD_WS_MSG_BURST=100
# EVENT (publishes):
SHIELD_WS_EVENT_RATE=5
SHIELD_WS_EVENT_BURST=50
# REQ + COUNT (queries):
SHIELD_WS_REQ_RATE=5
SHIELD_WS_REQ_BURST=20

# Allowed Nostr message types (first array element). Anything else
# closes the connection. NEG-* is strfry's negentropy sync.
SHIELD_NOSTR_TYPES=EVENT,REQ,CLOSE,COUNT,AUTH,NEG-OPEN,NEG-MSG,NEG-CLOSE

# Comma-separated event kinds to reject on publish (empty = allow all),
# e.g. "4,1059" to refuse legacy and gift-wrapped DMs.
SHIELD_NOSTR_KIND_DENY=

# --- Detection & response (Phase 3) ---
# fail2ban tails the shield logs and bans repeat offenders by writing
# to the banlist file via the shield-ban backend (docs/verdict-schema.md).
# nginx rejects banned sources at accept and cuts their live sessions.

# The banlist file. Shared between the enforcement backend (writer) and
# nginx (reader) — in container mode both mount the same volume.
SHIELD_BAN_FILE=/var/lib/fips-shield/banlist

# How often (seconds) an established session re-checks the banlist.
SHIELD_BAN_RECHECK=10

# fail2ban windows: violations within FINDTIME seconds count together;
# a ban lasts BANTIME seconds, doubling for repeat offenders (capped at
# one week).
SHIELD_F2B_FINDTIME=600
SHIELD_F2B_BANTIME=3600

# Violations before a ban, per jail:
# handshake: 429s from the http stage (handshake floods, conn caps) —
# generous, well-behaved clients can brush this limit.
SHIELD_F2B_HANDSHAKE_MAXRETRY=20
# verdict: message-level violations from the WS engine — each one
# already cost the client its connection; few are tolerated.
SHIELD_F2B_VERDICT_MAXRETRY=3
# scan: 444/405 responses (path/method probing).
SHIELD_F2B_SCAN_MAXRETRY=5

# Sources never banned (space-separated). Empty = ban anyone.
SHIELD_F2B_IGNOREIP=

# Ignore the fail2ban host's own addresses. Keep true in production;
# tests set false because everything runs on loopback there.
SHIELD_F2B_IGNORESELF=true
