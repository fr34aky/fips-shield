# fips-shield configuration. Copy to shield.env and edit.
#
# This file is deliberately short. Every key you do not set here comes
# from a preset (presets/<scope>/<level>.env), so you configure the few
# things specific to your node and inherit the rest.
#
#   shield-config levels          what strict/default/loose mean
#   shield-config show            every effective value, and where it came from
#   shield-config show http       one service only
#   shield-config diff            only what you have overridden
#
# Anything set here always wins over the preset. Values land verbatim in
# the nginx config, so quote nothing. A key repeated twice takes the
# last occurrence, matching docker --env-file.

# ---------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------

# Which profiles to run: comma-separated, one service each
# (e.g. "strfry,tcp"). Comma rather than space so the value needs no
# quoting — quotes are taken literally by docker --env-file.
# Available: strfry (Nostr relay, WebSocket-aware), http (any HTTP app),
# tcp (any plain TCP service). One profile = one service.
# See profiles/<name>/README.md.
SHIELD_PROFILES=strfry

# The fips0 mesh address the shield binds. Find it with:
#   ip -6 addr show fips0        (the fd97:... inet6 address)
# or: sudo fipsctl show status   (the ipv6_addr field)
SHIELD_BIND_ADDR=fd97:dead:beef:dead:beef:dead:beef:dead

# ---------------------------------------------------------------------
# Enforcement level
# ---------------------------------------------------------------------

# Applies to every service unless overridden per service below.
#   strict   tight limits, fast banning — for clients you know, or a
#            node under active abuse
#   default  balanced; what the smoke tests exercise
#   loose    generous limits, slow banning — for a busy public service
#            where a false positive costs more than an abusive peer
SHIELD_PRESET=default

# Per-service override, when one service needs a different level than
# the rest. Leave commented to inherit SHIELD_PRESET.
#SHIELD_STRFRY_PRESET=strict
#SHIELD_HTTP_PRESET=default
#SHIELD_TCP_PRESET=loose

# ---------------------------------------------------------------------
# Where your services actually live
# ---------------------------------------------------------------------
# The presets ship working ports; the upstream is yours. In every case
# the protected service must bind LOOPBACK ONLY — if it also listens on
# fips0, mesh peers reach it directly and the shield protects nothing.

# strfry: must match "port" in strfry.conf, whose bind must be 127.0.0.1
#SHIELD_UPSTREAM=127.0.0.1:7777

# http profile: your app, and the port exposed on the mesh
#SHIELD_HTTP_UPSTREAM=127.0.0.1:3000
#SHIELD_HTTP_LISTEN_PORT=8080

# tcp profile: the loopback service, and the port exposed on the mesh
#SHIELD_TCP_UPSTREAM=127.0.0.1:22
#SHIELD_TCP_LISTEN_PORT=2222

# ---------------------------------------------------------------------
# Custom values
# ---------------------------------------------------------------------
# Uncomment any key from a preset file to pin it; `shield-config show`
# then reports it as "custom" rather than "preset:...". Run
# `shield-config show` to see the full list of what you can pin.
# The ones people reach for most:

# Never ban these sources (space-separated).
#SHIELD_F2B_IGNOREIP=

# Nostr clients that legitimately page large result sets.
#SHIELD_WS_MAX_LIMIT=5000

# Serving uploads (Blossom, NIP-96) needs PUT/DELETE and a bigger body.
#SHIELD_HTTP_METHODS=GET HEAD POST PUT DELETE
#SHIELD_HTTP_MAX_BODY=16m

# With the eBPF guard as the backend, also maintain the banlist file so
# nginx's own view agrees and bans still apply while the guard is
# unloaded.
#SHIELD_BAN_ALSO_FILE=true
