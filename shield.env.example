# fips-shield configuration. Copy to shield.env and edit.
# Consumed by envsubst at render time (host mode: deploy/host/render.sh,
# container mode: the nginx image's template entrypoint) — values land
# verbatim in the nginx config, so quote nothing.

# Which profiles to run: comma-separated, one server block each
# (e.g. "strfry,tcp"). Comma rather than space so the value needs no
# quoting — quotes are taken literally by docker --env-file.
# Available: strfry (Nostr relay, WebSocket-aware), tcp (any plain TCP
# service). See profiles/<name>/README.md.
SHIELD_PROFILES=strfry

# The fips0 mesh address the shield binds. Find it with:
#   ip -6 addr show fips0        (the fd97:... inet6 address)
# or: sudo fipsctl show status   (the ipv6_addr field)
SHIELD_BIND_ADDR=fd97:dead:beef:dead:beef:dead:beef:dead

# Port the shield listens on. 80 makes the relay reachable as
# ws://<npub>.fips/ with no explicit port.
SHIELD_LISTEN_PORT=80

# server_name for the vhost. "_" accepts any Host header (mesh clients
# connect via <npub>.fips or the raw address interchangeably).
SHIELD_SERVER_NAME=_

# Where the protected strfry listens. Must be loopback — if strfry is
# reachable on fips0 directly, the shield protects nothing.
SHIELD_UPSTREAM=127.0.0.1:7777

# Directory holding the unix sockets that connect each profile's
# stream stage to its internal http stage. Must be readable only by
# the nginx worker user (mode 0700): anything that can connect to
# these sockets can spoof a client address past the shield.
SHIELD_SOCKET_DIR=/run/fips-shield

# --- Limits (all keyed per mesh source address == per node) ---

# WebSocket/NIP-11 handshakes per node. Steady-state clients open one
# connection and keep it; this prices churn and reconnect floods.
SHIELD_HANDSHAKE_RATE=5r/s
SHIELD_HANDSHAKE_BURST=10

# Concurrent connections per node.
SHIELD_MAX_CONNS_PER_NODE=8

# Shared-memory sizes for the limit state. 1m tracks ~16k distinct
# source addresses — plenty for any current mesh.
SHIELD_HANDSHAKE_ZONE_SIZE=1m
SHIELD_CONN_ZONE_SIZE=1m
SHIELD_CONNRATE_ZONE_SIZE=1m

# Connection-rate limiting (all profiles). Counted per node in a fixed
# window by the njs engine, since the stream module has no limit_req.
# The window length in seconds:
SHIELD_CONN_WINDOW=60
# Shared-dict entry lifetime; must exceed SHIELD_CONN_WINDOW.
SHIELD_CONNRATE_TIMEOUT=300s
# New connections per node per window for the strfry profile
# (0 disables). Prices TCP connections, which cost something even when
# no WebSocket handshake follows.
SHIELD_STRFRY_CONN_RATE=60

# Idle timeout for established WebSockets. Nostr clients ping; anything
# silent this long is dead weight.
SHIELD_WS_IDLE_TIMEOUT=300s

# --- WebSocket message policy (Phase 2, enforced inside the WS) ---
# Violating any of these closes the connection (client gets a NOTICE
# and a 1008 Close first) and logs a shield-verdict line.

# Max Nostr message size in bytes (whole message, across fragments).
# Align with strfry's maxWebsocketPayloadSize (default 131072).
SHIELD_WS_MAX_MSG=131072

# Concurrently open subscriptions (REQ) per connection.
SHIELD_WS_MAX_SUBS=20
# Reads (not bytes) a client may spend on one handshake, and on one
# WebSocket message. What this engine costs is per read callback, and
# the client picks the segment size: a byte-at-a-time handshake stays
# under every byte cap while costing ~300x the CPU of the same bytes
# delivered normally. A conforming client needs 1-2 reads for a
# handshake; a full-size message arrives in ~90 segments. Exceeding
# either closes the connection and logs a verdict, so repeat offenders
# are banned. Empty message-read cap = derived from SHIELD_WS_MAX_MSG.
SHIELD_WS_MAX_HS_READS=32
SHIELD_WS_MAX_MSG_READS=

# Filters per REQ/COUNT, and total complexity items per REQ/COUNT
# (filter keys + entries in ids/authors/kinds/#tag arrays, summed).
SHIELD_WS_MAX_FILTERS=10
SHIELD_WS_MAX_FILTER_ITEMS=500

# Token buckets, per connection: sustained rate (messages/second, may
# be fractional) and burst capacity.
# All message types combined:
SHIELD_WS_MSG_RATE=20
SHIELD_WS_MSG_BURST=100
# EVENT (publishes):
SHIELD_WS_EVENT_RATE=5
SHIELD_WS_EVENT_BURST=50
# REQ + COUNT (queries):
SHIELD_WS_REQ_RATE=5
SHIELD_WS_REQ_BURST=20

# Allowed Nostr message types (first array element). Anything else
# closes the connection. NEG-* is strfry's negentropy sync.
SHIELD_NOSTR_TYPES=EVENT,REQ,CLOSE,COUNT,AUTH,NEG-OPEN,NEG-MSG,NEG-CLOSE

# Comma-separated event kinds to reject on publish (empty = allow all),
# e.g. "4,1059" to refuse legacy and gift-wrapped DMs.
SHIELD_NOSTR_KIND_DENY=

# --- Detection & response (Phase 3) ---
# fail2ban tails the shield logs and bans repeat offenders by writing
# to the banlist file via the shield-ban backend (docs/verdict-schema.md).
# nginx rejects banned sources at accept and cuts their live sessions.

# The banlist file. Shared between the enforcement backend (writer) and
# nginx (reader) — in container mode both mount the same volume.
SHIELD_BAN_FILE=/var/lib/fips-shield/banlist

# How often (seconds) an established session re-checks the banlist.
SHIELD_BAN_RECHECK=10

# Only read by the eBPF backend (guard/shield-ban): also maintain the
# banlist file above, so nginx's own view agrees and bans still apply
# while the guard is unloaded. Redundant for enforcement — the kernel
# has already dropped the packets — but useful as a fallback and so
# `shield-ban list` matches across layers. Ignored by the file backend.
SHIELD_BAN_ALSO_FILE=false

# fail2ban windows: violations within FINDTIME seconds count together;
# a ban lasts BANTIME seconds, doubling for repeat offenders (capped at
# one week).
SHIELD_F2B_FINDTIME=600
SHIELD_F2B_BANTIME=3600

# Violations before a ban, per jail:
# handshake: 429s from the http stage (handshake floods, conn caps) —
# generous, well-behaved clients can brush this limit.
SHIELD_F2B_HANDSHAKE_MAXRETRY=20
# verdict: message-level violations from the WS engine — each one
# already cost the client its connection; few are tolerated.
SHIELD_F2B_VERDICT_MAXRETRY=3
# scan: 444/405 responses (path/method probing).
SHIELD_F2B_SCAN_MAXRETRY=5

# Sources never banned (space-separated). Empty = ban anyone.
SHIELD_F2B_IGNOREIP=

# Ignore the fail2ban host's own addresses. Keep true in production;
# tests set false because everything runs on loopback there.
SHIELD_F2B_IGNORESELF=true

# --- Profile: tcp (generic TCP service) ---
# Only used when "tcp" is in SHIELD_PROFILES. See profiles/tcp/README.md.

# Names the log file (shield-<service>.stream.log) and the log field.
SHIELD_TCP_SERVICE=tcp
# Port on the mesh address, and the loopback service behind it.
SHIELD_TCP_LISTEN_PORT=2222
SHIELD_TCP_UPSTREAM=127.0.0.1:22
# New connections per node per SHIELD_CONN_WINDOW (0 disables).
SHIELD_TCP_CONN_RATE=10
# Concurrent connections per node.
SHIELD_TCP_MAX_CONNS_PER_NODE=4
# Idle timeout. Long suits interactive sessions (SSH); shorten for RPC.
SHIELD_TCP_IDLE_TIMEOUT=1h

# --- Profile: http (generic HTTP service) ---
# Only used when "http" is in SHIELD_PROFILES. See profiles/http/README.md.
# Protects any HTTP app — an API, a dashboard, a static site — with
# request-level limits on top of the connection-level ones.

# Names the log files (shield-<service>.{access,stream}.log) and the
# service field in them.
SHIELD_HTTP_SERVICE=web
# Port on the mesh address, and the loopback app behind it.
SHIELD_HTTP_LISTEN_PORT=8080
SHIELD_HTTP_UPSTREAM=127.0.0.1:3000
# server_name; "_" accepts any Host header.
SHIELD_HTTP_SERVER_NAME=_

# Connection-level limits (per node).
SHIELD_HTTP_CONN_RATE=120
SHIELD_HTTP_MAX_CONNS_PER_NODE=30
# Idle timeout, also used for keep-alive and upstream reads. Raise it
# if the app streams responses or uses long-lived WebSockets.
SHIELD_HTTP_IDLE_TIMEOUT=75s

# Request-level limits (per node). Requests above the rate are delayed
# only up to the burst, then rejected with 429.
SHIELD_HTTP_REQ_RATE=20r/s
SHIELD_HTTP_REQ_BURST=40

# Allowed methods, space-separated. Anything else gets 403 — drop POST
# here if the app is read-only. (Enforced with limit_except so that
# rejected requests still count against the request-rate limit.)
SHIELD_HTTP_METHODS=GET HEAD POST

# Maximum requests per keep-alive connection.
SHIELD_HTTP_KEEPALIVE_REQUESTS=100

# Allowed paths, as a regex matched against the whole decoded URI.
# The default allows everything; narrow it to expose only what you
# mean to, e.g. "/api/.*|/health" to hide an admin panel.
SHIELD_HTTP_PATH_REGEX=.*

# Maximum request body. Lower it for JSON APIs (e.g. 256k), raise it
# for upload endpoints.
SHIELD_HTTP_MAX_BODY=1m
