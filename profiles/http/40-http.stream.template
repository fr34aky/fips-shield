# fips-shield profile: generic HTTP service — stream stage.
#
# Owns the fips0-facing listener and applies the protections that do
# not need to understand HTTP: ban enforcement at accept, per-node
# connection rate, per-node concurrency. It then hands the connection
# to the http stage (41-http.conf) on loopback via the PROXY protocol,
# so request-level limits there still key on the peer's mesh address.

server {
    listen [${SHIELD_BIND_ADDR}]:${SHIELD_HTTP_LISTEN_PORT};

    access_log /var/log/nginx/shield-${SHIELD_HTTP_SERVICE}.stream.log shield_stream_json;
    error_log /var/log/nginx/shield-error.log warn;

    # Port-keyed policy: see the note in core/njs/shield_core.js on why
    # a shared js_var name would leak between profiles.
    js_var $shield_cfg_${SHIELD_HTTP_LISTEN_PORT} 'service=${SHIELD_HTTP_SERVICE};ban_file=${SHIELD_BAN_FILE};conn_rate=${SHIELD_HTTP_CONN_RATE};conn_window=${SHIELD_CONN_WINDOW}';
    js_access shield_core.access;

    limit_conn shield_stream_conn ${SHIELD_HTTP_MAX_CONNS_PER_NODE};

    proxy_pass unix:${SHIELD_SOCKET_DIR}/${SHIELD_HTTP_SERVICE}.sock;
    proxy_protocol on;
    proxy_connect_timeout 5s;
    proxy_timeout ${SHIELD_HTTP_IDLE_TIMEOUT};
}
