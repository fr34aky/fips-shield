# fips-shield profile: strfry — stream stage (WebSocket inspection).
#
# Owns the fips0-facing listener. Client bytes run through the njs
# engine (core/njs/shield_ws.js), which enforces the Nostr message
# policy below before anything reaches the http stage; the http stage
# (10-strfry.conf) listens on loopback behind this and receives the
# real client address via the PROXY protocol.
#
# Shared plumbing (js_import, log format, zones) is in
# core/nginx/05-shield-core.stream.

server {
    listen [${SHIELD_BIND_ADDR}]:${SHIELD_LISTEN_PORT};

    access_log /var/log/nginx/shield-strfry.stream.log shield_stream_json;
    # shield-verdict lines (s.warn from the engine) land here — this is
    # the file the detection engine tails.
    error_log /var/log/nginx/shield-error.log warn;

    # Port-keyed policy: nginx variables are global by name, so a
    # shared $shield_* per-server js_var would take whichever profile
    # was parsed last and silently apply it to all of them. One string
    # keyed by listening port cannot collide.
    js_var $shield_cfg_${SHIELD_LISTEN_PORT} 'service=strfry;ban_file=${SHIELD_BAN_FILE};ban_recheck=${SHIELD_BAN_RECHECK};conn_rate=${SHIELD_STRFRY_CONN_RATE};conn_window=${SHIELD_CONN_WINDOW};ws_max_msg=${SHIELD_WS_MAX_MSG};ws_max_subs=${SHIELD_WS_MAX_SUBS};ws_max_filters=${SHIELD_WS_MAX_FILTERS};ws_max_filter_items=${SHIELD_WS_MAX_FILTER_ITEMS};ws_max_hs_reads=${SHIELD_WS_MAX_HS_READS};ws_max_msg_reads=${SHIELD_WS_MAX_MSG_READS};ws_max_limit=${SHIELD_WS_MAX_LIMIT};ws_max_filter_value=${SHIELD_WS_MAX_FILTER_VALUE};ws_require_narrowing=${SHIELD_WS_REQUIRE_NARROWING};ws_msg_rate=${SHIELD_WS_MSG_RATE};ws_msg_burst=${SHIELD_WS_MSG_BURST};ws_event_rate=${SHIELD_WS_EVENT_RATE};ws_event_burst=${SHIELD_WS_EVENT_BURST};ws_req_rate=${SHIELD_WS_REQ_RATE};ws_req_burst=${SHIELD_WS_REQ_BURST};nostr_types=${SHIELD_NOSTR_TYPES};nostr_kind_deny=${SHIELD_NOSTR_KIND_DENY}';
    js_access shield_core.access;

    js_filter shield_ws.filter;

    # Concurrent connections per mesh node, at the stream stage. The
    # http stage has its own limit_conn, but it only sees a connection
    # once the handshake completes — which is exactly the phase an
    # inspection-cost attack never leaves. Without this, the only brake
    # on held-open connections was SHIELD_STRFRY_CONN_RATE.
    limit_conn shield_stream_conn ${SHIELD_MAX_CONNS_PER_NODE};

    proxy_pass unix:${SHIELD_SOCKET_DIR}/strfry.sock;
    proxy_protocol on;
    # Also the reaper for sessions the engine has killed but whose
    # upstream ignored the injected Close frame.
    proxy_timeout ${SHIELD_WS_IDLE_TIMEOUT};
}
