# fips-shield profile: strfry — stream stage (WebSocket inspection).
#
# Owns the fips0-facing listener. Client bytes run through the njs
# engine (core/njs/shield_ws.js), which enforces the Nostr message
# policy below before anything reaches the http stage; the http stage
# (10-strfry.conf) listens on loopback behind this and receives the
# real client address via the PROXY protocol.
#
# Shared plumbing (js_import, log format, zones) is in
# core/nginx/05-shield-core.stream.

server {
    listen [${SHIELD_BIND_ADDR}]:${SHIELD_LISTEN_PORT};

    access_log /var/log/nginx/shield-strfry.stream.log shield_stream_json;
    # shield-verdict lines (s.warn from the engine) land here — this is
    # the file the detection engine tails.
    error_log /var/log/nginx/shield-error.log warn;

    js_var $shield_service strfry;

    # Ban enforcement: reject banned sources at accept, re-check
    # established sessions every SHIELD_BAN_RECHECK seconds.
    js_var $shield_ban_file '${SHIELD_BAN_FILE}';
    js_var $shield_ban_recheck ${SHIELD_BAN_RECHECK};
    # New connections per node per window (0 = off). The http stage's
    # limit_req prices handshakes; this prices TCP connections, which
    # cost something even when the handshake never completes.
    js_var $shield_conn_rate ${SHIELD_STRFRY_CONN_RATE};
    js_var $shield_conn_window ${SHIELD_CONN_WINDOW};
    js_access shield_core.access;

    # Message policy (see shield.env for per-knob documentation).
    js_var $shield_ws_max_msg ${SHIELD_WS_MAX_MSG};
    js_var $shield_ws_max_subs ${SHIELD_WS_MAX_SUBS};
    js_var $shield_ws_max_filters ${SHIELD_WS_MAX_FILTERS};
    js_var $shield_ws_max_filter_items ${SHIELD_WS_MAX_FILTER_ITEMS};
    js_var $shield_ws_msg_rate ${SHIELD_WS_MSG_RATE};
    js_var $shield_ws_msg_burst ${SHIELD_WS_MSG_BURST};
    js_var $shield_ws_event_rate ${SHIELD_WS_EVENT_RATE};
    js_var $shield_ws_event_burst ${SHIELD_WS_EVENT_BURST};
    js_var $shield_ws_req_rate ${SHIELD_WS_REQ_RATE};
    js_var $shield_ws_req_burst ${SHIELD_WS_REQ_BURST};
    js_var $shield_nostr_types '${SHIELD_NOSTR_TYPES}';
    js_var $shield_nostr_kind_deny '${SHIELD_NOSTR_KIND_DENY}';

    js_filter shield_ws.filter;

    proxy_pass 127.0.0.1:${SHIELD_HTTP_PORT};
    proxy_protocol on;
    # Also the reaper for sessions the engine has killed but whose
    # upstream ignored the injected Close frame.
    proxy_timeout ${SHIELD_WS_IDLE_TIMEOUT};
}
