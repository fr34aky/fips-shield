# fips-shield profile: generic TCP service.
#
# Protects any plain TCP service exposed to mesh peers — SSH, a
# database, a game server, an internal API — with the protections that
# do not require knowing the protocol: ban enforcement, per-node
# connection-rate limiting, per-node concurrency caps, and idle
# reaping. There is no http stage and no payload inspection; the shield
# never looks inside the connection.
#
# Everything here comes from the shared core (core/nginx/05-shield-core.stream,
# core/njs/shield_core.js) — the profile is only a server block, which
# is the point: adding a service means adding one of these.

server {
    listen [${SHIELD_BIND_ADDR}]:${SHIELD_TCP_LISTEN_PORT};

    access_log /var/log/nginx/shield-${SHIELD_TCP_SERVICE}.stream.log shield_stream_json;
    error_log /var/log/nginx/shield-error.log warn;

    js_var $shield_service ${SHIELD_TCP_SERVICE};

    js_var $shield_ban_file '${SHIELD_BAN_FILE}';
    js_var $shield_conn_rate ${SHIELD_TCP_CONN_RATE};
    js_var $shield_conn_window ${SHIELD_CONN_WINDOW};
    js_access shield_core.access;

    limit_conn shield_stream_conn ${SHIELD_TCP_MAX_CONNS_PER_NODE};

    proxy_pass ${SHIELD_TCP_UPSTREAM};
    proxy_connect_timeout 5s;
    proxy_timeout ${SHIELD_TCP_IDLE_TIMEOUT};
}
