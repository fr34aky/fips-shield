# fips-shield banaction: delegate to the shield-ban backend CLI
# (docs/verdict-schema.md). Swapping the enforcement backend (e.g. the
# eBPF guard) means pointing this at a different binary with the same
# CLI — the jails don't change.
#
# ${SHIELD_ACTION_ENV} expands to the assignments the backend reads —
# SHIELD_BAN_FILE, SHIELD_BAN_ALSO_FILE, and SHIELD_GUARD_PIN_DIR when
# it is set. They are passed explicitly rather than inherited: fail2ban
# runs actions with its own environment, which in host mode contains
# nothing from shield.env. Without this a non-default ban file means
# fail2ban writes bans to one path while nginx reads another, and a
# non-default guard pin directory means every ban targets maps that do
# not exist — enforcement silently does nothing while every log says it
# worked.
#
# The list is built by `shield-config action-env` rather than
# substituted key-by-key, because it is conditional: an unset key must
# be omitted, not rendered as `KEY=`. SHIELD_GUARD_PIN_DIR has no
# default in shield.env and fips-guard supplies its own, but clap treats
# a set-but-empty env var as the value — so emitting it empty would
# point the guard at nothing.

[Definition]
actionstart =
actionstop =
# Not empty any more. fail2ban treats a failing actioncheck as "the
# action is broken": it invalidates the ban epoch, after which every
# live ticket is re-applied. That is the self-healing path, and an
# empty actioncheck disables it — so a banlist lost to a tmpfs reboot,
# or an eBPF classifier that has been detached, was never repaired.
#
# Both backends implement "health" cheaply: the file backend checks the
# banlist directory is writable, the eBPF backend checks the watchdog
# heartbeat is fresh (it cannot check the attachment directly from the
# sidecar, which has no network namespace of its own).
actioncheck = ${SHIELD_ACTION_ENV} /usr/local/bin/shield-ban health
actionban = ${SHIELD_ACTION_ENV} /usr/local/bin/shield-ban ban <ip> <bantime>
actionunban = ${SHIELD_ACTION_ENV} /usr/local/bin/shield-ban unban <ip>
